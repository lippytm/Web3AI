{
  "categories": [
    {
      "title": "## 🚀 Features",
      "labels": ["feat", "feature", "enhancement"]
    },
    {
      "title": "## 🐛 Bug Fixes",
      "labels": ["fix", "bug", "bugfix"]
    },
    {
      "title": "## 📚 Documentation",
      "labels": ["docs", "documentation"]
    },
    {
      "title": "## ⚡ Performance",
      "labels": ["perf", "performance"]
    },
    {
      "title": "## 🔒 Security",
      "labels": ["security"]
    },
    {
      "title": "## 📦 Dependencies",
      "labels": ["dependencies"]
    },
    {
      "title": "## 🔧 Maintenance",
      "labels": ["chore", "refactor", "style"]
    },
    {
      "title": "## 🧪 Tests",
      "labels": ["test"]
    },
    {
      "title": "## 🔄 CI/CD",
      "labels": ["ci", "build", "workflows"]
    }
  ],
  "ignore_labels": [
    "stale",
    "wontfix",
    "duplicate"
  ],
  "sort": "ASC",
  "template": "#{{CHANGELOG}}\n\n**Full Changelog**: #{{RELEASE_DIFF}}",
  "pr_template": "- #{{TITLE}} by @#{{AUTHOR}} in ##{{NUMBER}}",
  "empty_template": "- No changes",
  "label_extractor": [
    {
      "pattern": "^(feat|feature)(\\(.+\\))?:",
      "target": "feat"
    },
    {
      "pattern": "^(fix|bugfix)(\\(.+\\))?:",
      "target": "fix"
    },
    {
      "pattern": "^docs(\\(.+\\))?:",
      "target": "docs"
    }
  ]
}
